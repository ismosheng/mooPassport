DEMO_PORT=4174
DEMO_BASE_URL=http://127.0.0.1:4174

# Moo Passport 前端地址，用于授权页面和浏览器 SDK。
MOO_PASSPORT_WEB_URL=http://127.0.0.1:3000

# Moo Passport 后端地址，仅由 Demo 服务端访问 Token、UserInfo 和撤销端点。
MOO_PASSPORT_API_URL=http://127.0.0.1:8787

# 在管理后台创建 Web 应用后填写。回调地址必须登记为：
# http://127.0.0.1:4174/callback
MOO_CLIENT_ID=
MOO_CLIENT_SECRET=
MOO_CLIENT_AUTH_METHOD=client_secret_basic
MOO_SCOPE=openid profile
