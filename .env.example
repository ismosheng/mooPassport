APP_NAME="Moo Passport"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8787
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moopassport
DB_USERNAME=moo_passport
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

SESSION_DRIVER=redis
SESSION_LIFETIME=604800
SESSION_COOKIE=moo_passport_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

OAUTH_ISSUER=http://127.0.0.1:8787
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_AUTH_CODE_TTL=300

MAILER_DSN=null://null
