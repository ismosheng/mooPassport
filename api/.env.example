APP_NAME="Moo Passport"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8787
APP_TIMEZONE=UTC
HTTP_LISTEN=http://0.0.0.0:8787

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moopassport
DB_USERNAME=moo_passport
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

SESSION_DRIVER=redis
SESSION_LIFETIME=604800
SESSION_COOKIE=moo_passport_session
AUTH_COOKIE=moo_auth_session
AUTH_COOKIE_DOMAIN=
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

OAUTH_ISSUER=http://127.0.0.1:8787
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_AUTH_CODE_TTL=300
OIDC_ID_TOKEN_TTL=300
OIDC_PRIVATE_KEY_ENCRYPTION_KEY=

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Moo Passport"
PASSPORT_WEB_URL=http://localhost:3000

# 逗号分隔；仅填写直接连接 Webman 的 Nginx、负载均衡或网关 IP/CIDR。
TRUSTED_PROXIES=
# 逗号分隔且必须是完整 Origin，不支持 *；生产环境填写真实前端域名。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 安全审计：热表默认保留 90 天，每天分批归档到按月冷表。
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_ARCHIVE_BATCH_SIZE=5000
AUDIT_ARCHIVE_MAX_BATCHES=20
AUDIT_ARCHIVE_INTERVAL=86400
AUDIT_COLD_RETENTION_DAYS=1095
# 冷归档删除不可恢复，生产环境评审后才可显式开启。
AUDIT_ARCHIVE_DELETE_ENABLED=false
